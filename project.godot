[application]

config/name="Reefrun"
config/description="99 fish. One reef. Last one swimming."
run/main_scene="res://scenes/boot/loading_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/delta_smoothing=false
boot_splash/bg_color=Color(0, 0.035294, 0.12549, 1)
boot_splash/image="uid://b0dou2y616hse"
