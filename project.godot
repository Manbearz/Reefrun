; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Reefrun"
config/description="99 fish. One reef. Last one swimming."
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/delta_smoothing=false
config/icon="res://icon.svg"

[autoload]

GameSession="*res://autoload/game_session.gd"
Backend="*res://autoload/backend.gd"
Sprites="*res://autoload/sprites.gd"
Sfx="*res://autoload/sfx.gd"
RewardedAds="*res://autoload/rewarded_ads.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="viewport"
window/handheld/orientation=1

[input]

flap={
"deadzone": 0.5,
